# Copy this file to ".env" and replace the placeholders. Never commit ".env".
PORT=5000
MONGODB_URI=your_mongodb_atlas_connection_string_here
# Allowed browser origin(s), comma-separated. http://127.0.0.1 is accepted automatically for localhost.
FRONTEND_URL=http://localhost:5173

# ---- Login (checked by the server) ----
# Without these, DEMO passwords (admin/admin123, trainee/trainee123) are used outside production.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin
TRAINEE_USERNAME=trainee
TRAINEE_PASSWORD=change_me_trainee
# Long random text used to sign login tokens (required when NODE_ENV=production).
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# ---- AI ----
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: change the Gemini model if this one is not available to your key
GEMINI_MODEL=gemini-3.6-flash

# ---- Network ----
# DNS servers used for the Atlas SRV lookup. "system" keeps your own resolver.
DNS_SERVERS=8.8.8.8,8.8.4.4
